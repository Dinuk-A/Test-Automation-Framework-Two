<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Framework Sanity Suite">

    <test name="Playwright API Sanity">
        <classes>
            <class name="dinuka.automation.client_a.api_tests.PlaywrightAPISanityTest" />
        </classes>
    </test>

    <test name="REST Assured API Sanity">
        <classes>
            <class name="dinuka.automation.client_a.api_tests.RestAssuredAPISanityTest" />
        </classes>
    </test>

    <test name="Playwright UI Sanity">
        <classes>
            <class name="dinuka.automation.client_a.ui_tests.PlaywrightUISanityTest" />
        </classes>
    </test>

    <!-- SeleniumBaseTest#setUp requires "browser" and "headless" suite params -
         unlike PlaywrightBaseTest these are not @Optional/defaulted. -->
    <test name="Selenium UI Sanity">
        <parameter name="browser" value="chrome" />
        <parameter name="headless" value="false" />
        <classes>
            <class name="dinuka.automation.client_a.ui_tests.SeleniumUISanityTest" />
        </classes>
    </test>

</suite>

